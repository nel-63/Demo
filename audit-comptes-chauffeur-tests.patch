+    ["PLANNED", "PLANNED"],
+    ["IN_PROGRESS", "PLANNED"],
+    ["COMPLETED", "IN_PROGRESS"],
+    ["COMPLETED", "CANCELLED"],
+    ["CANCELLED", "PLANNED"],
+    ["CANCELLED", "IN_PROGRESS"],
+  ])("%s → %s est refusé", async (from, to) => {
+    givenTransport(from);
+    const { status } = await read(await patch({ status: to }));
+
+    expect(status).toBe(409);
+    expect(db.transportAssignment.update).not.toHaveBeenCalled();
