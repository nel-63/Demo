+describe("transitions autorisées", () => {
+  it.each([
+    ["PLANNED", "IN_PROGRESS"],
+    ["PLANNED", "CANCELLED"],
+    ["IN_PROGRESS", "COMPLETED"],
+    ["IN_PROGRESS", "CANCELLED"],
+  ])("%s → %s est accepté et journalisé", async (from, to) => {
+    givenTransport(from);
+    const { status } = await read(await patch({ status: to }));
