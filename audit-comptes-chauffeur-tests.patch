diff --git a/prisma/migrations/20261028090000_add_assignment_driver_snapshot/migration.sql b/prisma/migrations/20261028090000_add_assignment_driver_snapshot/migration.sql
new file mode 100644
index 0000000..d81bb73
--- /dev/null
+++ b/prisma/migrations/20261028090000_add_assignment_driver_snapshot/migration.sql
@@ -0,0 +1,14 @@
+-- AlterTable
+ALTER TABLE "TransportAssignment" ADD COLUMN     "driverId" TEXT;
+
+-- Reprise de l'existant : chaque ancien transport garde le chauffeur actuel de son vehicule.
+UPDATE "TransportAssignment" AS ta
+SET "driverId" = v."driverId"
+FROM "Vehicle" AS v
+WHERE ta."vehicleId" = v."id";
+
+-- CreateIndex
+CREATE INDEX "TransportAssignment_driverId_idx" ON "TransportAssignment"("driverId");
+
+-- AddForeignKey
+ALTER TABLE "TransportAssignment" ADD CONSTRAINT "TransportAssignment_driverId_fkey" FOREIGN KEY ("driverId") REFERENCES "Driver"("id") ON DELETE RESTRICT ON UPDATE CASCADE;
diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index cc53fe5..2f3dd03 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -84,7 +84,8 @@ model Driver {
   createdAt     DateTime @default(now())
   updatedAt     DateTime @updatedAt
 
-  vehicles Vehicle[]
+  vehicles    Vehicle[]
+  assignments TransportAssignment[] @relation("AssignmentDriver")
 
   supervisorId String?
   supervisor   Supervisor? @relation("SupervisorDrivers", fields: [supervisorId], references: [id], onDelete: Restrict)
@@ -150,9 +151,14 @@ model TransportAssignment {
 
   amountDue Decimal? @db.Decimal(14, 2)
 
+  // Chauffeur au moment du transport : conserve l'historique si le vehicule change de chauffeur.
+  driverId String?
+  driver   Driver? @relation("AssignmentDriver", fields: [driverId], references: [id], onDelete: Restrict)
+
   @@index([locationId])
   @@index([supervisorId])
   @@index([vehicleId])
+  @@index([driverId])
   @@index([assignedAt])
   @@index([status])
 }
diff --git a/tests/api/access-control.test.ts b/tests/api/access-control.test.ts
new file mode 100644
index 0000000..fd827ac
--- /dev/null
+++ b/tests/api/access-control.test.ts
@@ -0,0 +1,115 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { prisma } from "@/lib/prisma";
+import { getCurrentUser } from "@/lib/auth";
+import { resetFakePrisma, type FakePrisma } from "../helpers/fake-prisma";
+import { ADMIN, SUPERVISOR, jsonRequest, params } from "../helpers/http";
+
+import { POST as driversPost } from "@/app/api/drivers/route";
+import { PUT as driversPut, PATCH as driversPatch } from "@/app/api/drivers/[id]/route";
+import { POST as vehiclesPost } from "@/app/api/vehicles/route";
+import { PUT as vehiclesPut, PATCH as vehiclesPatch } from "@/app/api/vehicles/[id]/route";
+import { POST as transportsPost } from "@/app/api/transports/route";
+import { PATCH as transportsPatch } from "@/app/api/transports/[id]/route";
+import { POST as paymentsPost } from "@/app/api/payments/route";
+import { POST as locationsPost } from "@/app/api/locations/route";
+import { POST as supervisorsPost } from "@/app/api/supervisors/route";
+import { PATCH as supervisorsPatch } from "@/app/api/supervisors/[id]/route";
+import { POST as supervisorsPassword } from "@/app/api/supervisors/[id]/password/route";
+import { GET as dbTest } from "@/app/api/db-test/route";
+
+vi.mock("@/lib/prisma", async () => {
+  const { createFakePrisma } = await import("../helpers/fake-prisma");
+  return { prisma: createFakePrisma() };
+});
+vi.mock("@/lib/auth", () => ({ getCurrentUser: vi.fn() }));
+
+const db = prisma as unknown as FakePrisma;
+
+type Call = () => Promise<Response>;
+
+const body = { x: "y" };
+const post = (url: string) => jsonRequest(url, "POST", body);
+const put = (url: string) => jsonRequest(url, "PUT", body);
+const patch = (url: string) => jsonRequest(url, "PATCH", body);
+
+// Routes réservées aux régisseurs : formulaires opérationnels.
+const supervisorRoutes: Array<[string, Call]> = [
+  ["POST /api/drivers", () => driversPost(post("/api/drivers"))],
+  ["PUT /api/drivers/[id]", () => driversPut(put("/api/drivers/x"), params())],
+  ["PATCH /api/drivers/[id]", () => driversPatch(patch("/api/drivers/x"), params())],
+  ["POST /api/vehicles", () => vehiclesPost(post("/api/vehicles"))],
+  ["PUT /api/vehicles/[id]", () => vehiclesPut(put("/api/vehicles/x"), params())],
+  ["PATCH /api/vehicles/[id]", () => vehiclesPatch(patch("/api/vehicles/x"), params())],
+  ["POST /api/transports", () => transportsPost(post("/api/transports"))],
+  ["PATCH /api/transports/[id]", () => transportsPatch(patch("/api/transports/x"), params())],
+  ["POST /api/payments", () => paymentsPost(post("/api/payments"))],
+];
+
+// Routes réservées à l'administrateur : lieux et comptes.
+const adminRoutes: Array<[string, Call]> = [
+  ["POST /api/locations", () => locationsPost(post("/api/locations"))],
+  ["POST /api/supervisors", () => supervisorsPost(post("/api/supervisors"))],
+  ["PATCH /api/supervisors/[id]", () => supervisorsPatch(patch("/api/supervisors/x"), params())],
+  ["POST /api/supervisors/[id]/password", () => supervisorsPassword(post("/api/supervisors/x/password"), params())],
+  ["GET /api/db-test", () => dbTest()],
+];
+
+// Aucune de ces routes ne doit toucher à la base avant d'avoir vérifié l'identité et le rôle.
+function expectDatabaseUntouched() {
+  expect(db.$transaction).not.toHaveBeenCalled();
+  for (const [name, model] of Object.entries(db)) {
+    if (name.startsWith("$")) continue;
+    for (const fn of Object.values(model as Record<string, { mock: { calls: unknown[] } }>)) {
+      expect(fn.mock.calls).toHaveLength(0);
+    }
+  }
+}
+
+beforeEach(() => {
+  resetFakePrisma(db);
+});
+
+describe("utilisateur non connecté : toute l'API est fermée", () => {
+  it.each([...supervisorRoutes, ...adminRoutes])("%s → 401", async (_name, call) => {
+    vi.mocked(getCurrentUser).mockResolvedValue(null);
+    const response = await call();
+
+    expect(response.status).toBe(401);
+    expectDatabaseUntouched();
+  });
+});
+
+describe("l'administrateur n'accède pas aux formulaires opérationnels", () => {
+  it.each(supervisorRoutes)("%s → 403", async (_name, call) => {
+    vi.mocked(getCurrentUser).mockResolvedValue(ADMIN);
+    const response = await call();
+
+    expect(response.status).toBe(403);
+    expectDatabaseUntouched();
+  });
+});
+
+describe("un régisseur n'accède pas à l'administration", () => {
+  it.each(adminRoutes)("%s → 403", async (_name, call) => {
+    vi.mocked(getCurrentUser).mockResolvedValue(SUPERVISOR);
+    const response = await call();
+
+    expect(response.status).toBe(403);
+    expectDatabaseUntouched();
+  });
+});
+
+describe("rôles non prévus (CASHIER, MANAGER, ANALYST)", () => {
+  it.each(["CASHIER", "MANAGER", "ANALYST"] as const)(
+    "%s est refusé partout",
+    async (role) => {
+      vi.mocked(getCurrentUser).mockResolvedValue({ ...SUPERVISOR, role });
+
+      for (const [, call] of [...supervisorRoutes, ...adminRoutes]) {
+        const response = await call();
+        expect(response.status).toBe(403);
+      }
+      expectDatabaseUntouched();
+    },
+  );
+});
diff --git a/tests/api/login.test.ts b/tests/api/login.test.ts
new file mode 100644
index 0000000..2a7d143
--- /dev/null
+++ b/tests/api/login.test.ts
@@ -0,0 +1,136 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import bcrypt from "bcryptjs";
+import { POST as login } from "@/app/api/auth/login/route";
+import { POST as logout } from "@/app/api/auth/logout/route";
+import { prisma } from "@/lib/prisma";
+import { createSession, endSession } from "@/lib/auth";
+import { resetFakePrisma, type FakePrisma } from "../helpers/fake-prisma";
+import { jsonRequest, read } from "../helpers/http";
+
+vi.mock("@/lib/prisma", async () => {
+  const { createFakePrisma } = await import("../helpers/fake-prisma");
+  return { prisma: createFakePrisma() };
+});
+vi.mock("@/lib/auth", () => ({
+  createSession: vi.fn(),
+  endSession: vi.fn(),
+}));
+
+const db = prisma as unknown as FakePrisma;
+
+const PASSWORD = "Mot-de-passe-correct-1";
+// Coût 4 : suffisant pour un test, bien plus rapide que le coût 12 de production.
+const hash = bcrypt.hashSync(PASSWORD, 4);
+
+function user(overrides: Record<string, unknown> = {}) {
+  return {
+    id: "u1",
+    firstName: "Rina",
+    lastName: "R",
+    email: "rina@test.mg",
+    passwordHash: hash,
+    role: "SUPERVISOR",
+    isActive: true,
+    sessionVersion: 3,
+    ...overrides,
+  };
+}
+
+function attempt(email: string, password: string) {
+  return login(jsonRequest("/api/auth/login", "POST", { email, password }));
+}
+
+beforeEach(() => {
+  resetFakePrisma(db);
+  vi.mocked(createSession).mockReset();
+  vi.mocked(endSession).mockReset();
+  db.loginFailure.count.mockResolvedValue(0);
+});
+
+describe("connexion réussie", () => {
+  it("ouvre une session avec la version de session actuelle et efface les échecs", async () => {
+    db.user.findUnique.mockResolvedValue(user());
+    const { status, body } = await read(await attempt("Rina@Test.mg ", PASSWORD));
+
+    expect(status).toBe(200);
+    expect(createSession).toHaveBeenCalledWith({ id: "u1", sessionVersion: 3 });
+    expect(db.user.findUnique.mock.calls[0][0].where).toEqual({ email: "rina@test.mg" });
+    expect(db.loginFailure.deleteMany).toHaveBeenCalled();
+    expect(JSON.stringify(body)).not.toContain("passwordHash");
+  });
+});
+
+describe("erreurs de connexion", () => {
+  it("refuse un mauvais mot de passe et enregistre l'échec", async () => {
+    db.user.findUnique.mockResolvedValue(user());
+    const { status, body } = await read(await attempt("rina@test.mg", "mauvais-mot-de-passe"));
+
+    expect(status).toBe(401);
+    expect(body.message).toBe("Email ou mot de passe incorrect.");
+    expect(createSession).not.toHaveBeenCalled();
+    expect(db.loginFailure.create).toHaveBeenCalledTimes(1);
+  });
+
+  it("répond de la même façon pour un email inconnu (pas de fuite d'information)", async () => {
+    db.user.findUnique.mockResolvedValue(null);
+    const unknown = await read(await attempt("inconnu@test.mg", PASSWORD));
+
+    db.user.findUnique.mockResolvedValue(user());
+    const wrong = await read(await attempt("rina@test.mg", "mauvais-mot-de-passe"));
+
+    expect(unknown.status).toBe(401);
+    expect(unknown).toEqual(wrong);
+  });
+
+  it("refuse un compte désactivé même avec le bon mot de passe", async () => {
+    db.user.findUnique.mockResolvedValue(user({ isActive: false }));
+    const { status } = await read(await attempt("rina@test.mg", PASSWORD));
+
+    expect(status).toBe(401);
+    expect(createSession).not.toHaveBeenCalled();
+  });
+
+  it("refuse des champs vides ou trop longs", async () => {
+    expect((await read(await attempt("", PASSWORD))).status).toBe(400);
+    expect((await read(await attempt("rina@test.mg", ""))).status).toBe(400);
+    expect((await read(await attempt("rina@test.mg", "x".repeat(201)))).status).toBe(400);
+    expect(db.user.findUnique).not.toHaveBeenCalled();
+  });
+});
+
+describe("limitation des tentatives", () => {
+  it("bloque un email après 5 échecs, même avec le bon mot de passe", async () => {
+    db.loginFailure.count.mockResolvedValueOnce(5).mockResolvedValueOnce(0);
+    db.user.findUnique.mockResolvedValue(user());
+    const response = await attempt("rina@test.mg", PASSWORD);
+
+    expect(response.status).toBe(429);
+    expect(response.headers.get("Retry-After")).toBe("900");
+    expect(db.user.findUnique).not.toHaveBeenCalled();
+    expect(createSession).not.toHaveBeenCalled();
+  });
+
+  it("bloque une adresse IP après 20 échecs", async () => {
+    db.loginFailure.count.mockResolvedValueOnce(0).mockResolvedValueOnce(20);
+    const response = await attempt("autre@test.mg", PASSWORD);
+
+    expect(response.status).toBe(429);
+    expect(db.user.findUnique).not.toHaveBeenCalled();
+  });
+});
+
+describe("déconnexion", () => {
+  it("invalide la session côté serveur", async () => {
+    const { status } = await read(await logout());
+
+    expect(status).toBe(200);
+    expect(endSession).toHaveBeenCalledTimes(1);
+  });
+
+  it("répond quand même si l'invalidation échoue (le cookie est supprimé)", async () => {
+    vi.mocked(endSession).mockRejectedValue(new Error("base indisponible"));
+    vi.spyOn(console, "error").mockImplementation(() => {});
+
+    expect((await read(await logout())).status).toBe(200);
+  });
+});
diff --git a/tests/api/payments.test.ts b/tests/api/payments.test.ts
new file mode 100644
index 0000000..6042ba0
--- /dev/null
+++ b/tests/api/payments.test.ts
@@ -0,0 +1,216 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { POST } from "@/app/api/payments/route";
+import { prisma } from "@/lib/prisma";
+import { getCurrentUser } from "@/lib/auth";
+import { auditEntries, resetFakePrisma, type FakePrisma } from "../helpers/fake-prisma";
+import { ADMIN, SUPERVISOR, jsonRequest, read } from "../helpers/http";
+
+vi.mock("@/lib/prisma", async () => {
+  const { createFakePrisma } = await import("../helpers/fake-prisma");
+  return { prisma: createFakePrisma() };
+});
+vi.mock("@/lib/auth", () => ({ getCurrentUser: vi.fn() }));
+
+const db = prisma as unknown as FakePrisma;
+
+function pay(body: Record<string, unknown>) {
+  return POST(jsonRequest("/api/payments", "POST", { assignmentId: "t1", ...body }));
+}
+
+// Transport de base : 40 000 MGA dus, non payé, non annulé.
+function givenTransport(overrides: Record<string, unknown> = {}) {
+  db.transportAssignment.findFirst.mockResolvedValue({
+    id: "t1",
+    amountDue: "40000.00",
+    payment: null,
+    ...overrides,
+  });
+}
+
+beforeEach(() => {
+  resetFakePrisma(db);
+  vi.mocked(getCurrentUser).mockResolvedValue(SUPERVISOR);
+  db.supervisor.findUnique.mockResolvedValue({ id: "sup-1", locationId: "loc-1" });
+  db.payment.create.mockImplementation(async ({ data }: { data: Record<string, unknown> }) => ({
+    id: "pay-1",
+    ...data,
+  }));
+});
+
+describe("accès", () => {
+  it("refuse un utilisateur non connecté", async () => {
+    vi.mocked(getCurrentUser).mockResolvedValue(null);
+    const { status } = await read(await pay({ amountReceived: "40000", paymentMethod: "CASH" }));
+    expect(status).toBe(401);
+    expect(db.payment.create).not.toHaveBeenCalled();
+  });
+
+  it("refuse l'administrateur (formulaire réservé aux régisseurs)", async () => {
+    vi.mocked(getCurrentUser).mockResolvedValue(ADMIN);
+    const { status } = await read(await pay({ amountReceived: "40000", paymentMethod: "CASH" }));
+    expect(status).toBe(403);
+    expect(db.payment.create).not.toHaveBeenCalled();
+  });
+
+  it("refuse un régisseur sans lieu affecté", async () => {
+    db.supervisor.findUnique.mockResolvedValue({ id: "sup-1", locationId: null });
+    const { status } = await read(await pay({ amountReceived: "40000", paymentMethod: "CASH" }));
+    expect(status).toBe(403);
+  });
+});
+
+describe("paiement en espèces", () => {
+  it("calcule la monnaie à rendre quand le montant reçu dépasse le montant dû", async () => {
+    givenTransport();
+    const { status, body } = await read(
+      await pay({ amountReceived: "50000", paymentMethod: "CASH" }),
+    );
+
+    expect(status).toBe(201);
+    expect(db.payment.create.mock.calls[0][0].data).toMatchObject({
+      amountDue: "40000.00",
+      amountReceived: "50000.00",
+      changeReturned: "10000.00",
+    });
+    expect((body.payment as Record<string, string>).changeReturned).toBe("10000.00");
+  });
+
+  it("accepte le montant exact sans monnaie", async () => {
+    givenTransport();
+    const { status } = await read(await pay({ amountReceived: "40000", paymentMethod: "CASH" }));
+    expect(status).toBe(201);
+    expect(db.payment.create.mock.calls[0][0].data.changeReturned).toBe("0.00");
+  });
+
+  it("refuse un montant reçu insuffisant (aucun paiement partiel)", async () => {
+    givenTransport();
+    const { status } = await read(await pay({ amountReceived: "39999.99", paymentMethod: "CASH" }));
+    expect(status).toBe(400);
+    expect(db.payment.create).not.toHaveBeenCalled();
+  });
+});
+
+describe("paiement non liquide", () => {
+  it("exige une référence", async () => {
+    givenTransport();
+    const { status } = await read(
+      await pay({ amountReceived: "40000", paymentMethod: "BANK_TRANSFER" }),
+    );
+    expect(status).toBe(400);
+    expect(db.payment.create).not.toHaveBeenCalled();
+  });
+
+  it("exige le montant exact, même supérieur", async () => {
+    givenTransport();
+    const { status } = await read(
+      await pay({ amountReceived: "40001", paymentMethod: "MOBILE_MONEY", reference: "MM-1" }),
+    );
+    expect(status).toBe(400);
+    expect(db.payment.create).not.toHaveBeenCalled();
+  });
+
+  it("refuse un montant incomplet", async () => {
+    givenTransport();
+    const { status } = await read(
+      await pay({ amountReceived: "30000", paymentMethod: "CHECK", reference: "CHQ-9" }),
+    );
+    expect(status).toBe(400);
+    expect(db.payment.create).not.toHaveBeenCalled();
+  });
+
+  it("enregistre un paiement exact avec référence", async () => {
+    givenTransport();
+    const { status } = await read(
+      await pay({ amountReceived: "40000", paymentMethod: "BANK_TRANSFER", reference: "VIR-1" }),
+    );
+    expect(status).toBe(201);
+    expect(db.payment.create.mock.calls[0][0].data).toMatchObject({
+      paymentMethod: "BANK_TRANSFER",
+      reference: "VIR-1",
+      changeReturned: "0.00",
+    });
+  });
+});
+
+describe("règles du transport", () => {
+  it("ignore tout montant dû envoyé par le client : la base fait foi", async () => {
+    givenTransport();
+    await pay({ amountReceived: "40000", paymentMethod: "CASH", amountDue: "1" });
+    expect(db.payment.create.mock.calls[0][0].data.amountDue).toBe("40000.00");
+  });
+
+  it("refuse un transport annulé ou hors du lieu (introuvable)", async () => {
+    db.transportAssignment.findFirst.mockResolvedValue(null);
+    const { status } = await read(await pay({ amountReceived: "40000", paymentMethod: "CASH" }));
+    expect(status).toBe(404);
+    // la recherche exclut les transports annulés et ceux d'un autre lieu
+    expect(db.transportAssignment.findFirst.mock.calls[0][0].where).toMatchObject({
+      locationId: "loc-1",
+      status: { not: "CANCELLED" },
+    });
+  });
+
+  it("refuse un transport sans montant officiel", async () => {
+    givenTransport({ amountDue: null });
+    const { status } = await read(await pay({ amountReceived: "40000", paymentMethod: "CASH" }));
+    expect(status).toBe(400);
+  });
+
+  it("refuse un second paiement", async () => {
+    givenTransport({ payment: { id: "pay-0" } });
+    const { status } = await read(await pay({ amountReceived: "40000", paymentMethod: "CASH" }));
+    expect(status).toBe(409);
+    expect(db.payment.create).not.toHaveBeenCalled();
+  });
+
+  it("convertit un paiement concurrent (contrainte unique) en refus 409", async () => {
+    givenTransport();
+    db.payment.create.mockRejectedValue(Object.assign(new Error("unique"), { code: "P2002" }));
+    const { status } = await read(await pay({ amountReceived: "40000", paymentMethod: "CASH" }));
+    expect(status).toBe(409);
+  });
+
+  it("verrouille la ligne du transport avant de décider", async () => {
+    givenTransport();
+    await pay({ amountReceived: "40000", paymentMethod: "CASH" });
+    expect(db.$queryRaw).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe("validation des champs", () => {
+  it.each([
+    ["montant négatif", { amountReceived: "-5", paymentMethod: "CASH" }],
+    ["montant à 3 décimales", { amountReceived: "10.123", paymentMethod: "CASH" }],
+    ["montant non numérique", { amountReceived: "abc", paymentMethod: "CASH" }],
+    ["montant nul", { amountReceived: "0", paymentMethod: "CASH" }],
+    ["mode inconnu", { amountReceived: "40000", paymentMethod: "BITCOIN" }],
+    ["montant manquant", { paymentMethod: "CASH" }],
+  ])("refuse : %s", async (_label, body) => {
+    givenTransport();
+    const { status } = await read(await pay(body));
+    expect(status).toBe(400);
+    expect(db.payment.create).not.toHaveBeenCalled();
+  });
+});
+
+describe("traçabilité", () => {
+  it("journalise le montant, le mode et la référence du paiement", async () => {
+    givenTransport();
+    await pay({ amountReceived: "50000", paymentMethod: "CASH" });
+
+    const [entry] = auditEntries(db);
+    expect(entry).toMatchObject({
+      userId: SUPERVISOR.id,
+      action: "CREATE",
+      entityType: "Payment",
+      entityId: "pay-1",
+    });
+    expect(entry.details).toMatchObject({
+      assignmentId: "t1",
+      paymentMethod: "CASH",
+      amountDue: "40000.00",
+      amountReceived: "50000.00",
+      changeReturned: "10000.00",
+    });
+  });
+});
diff --git a/tests/api/supervisors-admin.test.ts b/tests/api/supervisors-admin.test.ts
new file mode 100644
index 0000000..49f0f2d
--- /dev/null
+++ b/tests/api/supervisors-admin.test.ts
@@ -0,0 +1,176 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import bcrypt from "bcryptjs";
+import { PATCH } from "@/app/api/supervisors/[id]/route";
+import { POST as resetPassword } from "@/app/api/supervisors/[id]/password/route";
+import { prisma } from "@/lib/prisma";
+import { getCurrentUser } from "@/lib/auth";
+import { auditEntries, resetFakePrisma, type FakePrisma } from "../helpers/fake-prisma";
+import { ADMIN, SUPERVISOR, jsonRequest, params, read } from "../helpers/http";
+
+vi.mock("@/lib/prisma", async () => {
+  const { createFakePrisma } = await import("../helpers/fake-prisma");
+  return { prisma: createFakePrisma() };
+});
+vi.mock("@/lib/auth", () => ({ getCurrentUser: vi.fn() }));
+
+const db = prisma as unknown as FakePrisma;
+
+function givenSupervisor(isActive: boolean) {
+  db.supervisor.findUnique.mockResolvedValue({
+    id: "sup-1",
+    userId: "user-sup-1",
+    user: { email: "rina@test.mg", isActive },
+  });
+}
+
+beforeEach(() => {
+  resetFakePrisma(db);
+  vi.mocked(getCurrentUser).mockResolvedValue(ADMIN);
+});
+
+describe("désactivation / réactivation du compte", () => {
+  const patch = (body: unknown) =>
+    PATCH(jsonRequest("/api/supervisors/sup-1", "PATCH", body), params("sup-1"));
+
+  it("désactive le compte, ferme ses sessions et journalise", async () => {
+    givenSupervisor(true);
+    const { status } = await read(await patch({ isActive: false }));
+
+    expect(status).toBe(200);
+    expect(db.user.update.mock.calls[0][0]).toMatchObject({
+      where: { id: "user-sup-1" },
+      data: { isActive: false, sessionVersion: { increment: 1 } },
+    });
+    expect(auditEntries(db)[0]).toMatchObject({
+      userId: ADMIN.id,
+      action: "DEACTIVATE",
+      entityType: "Supervisor",
+      entityId: "sup-1",
+      details: { email: "rina@test.mg" },
+    });
+  });
+
+  it("réactive le compte sans toucher à la version de session", async () => {
+    givenSupervisor(false);
+    const { status } = await read(await patch({ isActive: true }));
+
+    expect(status).toBe(200);
+    expect(db.user.update.mock.calls[0][0].data).toEqual({ isActive: true });
+    expect(auditEntries(db)[0]).toMatchObject({ action: "ACTIVATE" });
+  });
+
+  it("refuse de désactiver un compte déjà inactif", async () => {
+    givenSupervisor(false);
+    expect((await read(await patch({ isActive: false }))).status).toBe(409);
+    expect(db.user.update).not.toHaveBeenCalled();
+  });
+
+  it("répond 404 pour un régisseur inconnu", async () => {
+    db.supervisor.findUnique.mockResolvedValue(null);
+    expect((await read(await patch({ isActive: false }))).status).toBe(404);
+  });
+
+  it("refuse un statut qui n'est pas un booléen", async () => {
+    expect((await read(await patch({ isActive: "false" }))).status).toBe(400);
+  });
+
+  it("refuse de mélanger statut et changement de lieu", async () => {
+    expect((await read(await patch({ isActive: false, locationId: "loc-2" }))).status).toBe(400);
+    expect(db.user.update).not.toHaveBeenCalled();
+  });
+
+  it("refuse un régisseur et un utilisateur non connecté", async () => {
+    vi.mocked(getCurrentUser).mockResolvedValue(SUPERVISOR);
+    expect((await read(await patch({ isActive: false }))).status).toBe(403);
+    vi.mocked(getCurrentUser).mockResolvedValue(null);
+    expect((await read(await patch({ isActive: false }))).status).toBe(401);
+    expect(db.user.update).not.toHaveBeenCalled();
+  });
+});
+
+describe("changement de lieu (non-régression)", () => {
+  it("garde le comportement existant : le lieu change et l'historique est conservé", async () => {
+    db.supervisor.findUnique.mockResolvedValue({
+      id: "sup-1",
+      locationId: "loc-1",
+      location: "Tana",
+      user: { firstName: "R", lastName: "R", email: "rina@test.mg" },
+    });
+    db.location.findUnique.mockResolvedValue({ id: "loc-2", name: "Tamatave" });
+    db.supervisor.update.mockResolvedValue({ id: "sup-1", locationId: "loc-2" });
+
+    const { status } = await read(
+      await PATCH(jsonRequest("/api/supervisors/sup-1", "PATCH", { locationId: "loc-2" }), params("sup-1")),
+    );
+
+    expect(status).toBe(200);
+    expect(db.supervisor.update.mock.calls[0][0].data).toEqual({
+      locationId: "loc-2",
+      location: "Tamatave",
+    });
+    expect(auditEntries(db)[0]).toMatchObject({ action: "CHANGE_LOCATION" });
+    // aucun transport, véhicule ou chauffeur n'est déplacé
+    expect(db.transportAssignment.update).not.toHaveBeenCalled();
+    expect(db.vehicle.update).not.toHaveBeenCalled();
+    expect(db.driver.update).not.toHaveBeenCalled();
+  });
+});
+
+describe("réinitialisation du mot de passe", () => {
+  const reset = (body: unknown) =>
+    resetPassword(jsonRequest("/api/supervisors/sup-1/password", "POST", body), params("sup-1"));
+
+  beforeEach(() => givenSupervisor(true));
+
+  it("enregistre un hash bcrypt, ferme les sessions et lève le blocage de connexion", async () => {
+    const newPassword = "Nouveau-mot-de-passe-42";
+    const { status } = await read(await reset({ password: newPassword }));
+
