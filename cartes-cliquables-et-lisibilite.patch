+  from { opacity: 0; }
+  to { opacity: 1; }
+}
+
+.details-backdrop { animation: backdrop-in 200ms ease-out; }
+.details-panel { animation: sheet-in-up 200ms ease-out; }
+@media (min-width: 768px) {
+  .details-panel { animation-name: drawer-in-right; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .details-backdrop, .details-panel { animation: none; }
 }
