diff --git a/lib/payment-rules.ts b/lib/payment-rules.ts
new file mode 100644
index 0000000..770636f
--- /dev/null
+++ b/lib/payment-rules.ts
@@ -0,0 +1,42 @@
+// Règles de paiement d'un passage (montants en centimes pour éviter les erreurs d'arrondi).
+
+export const PAYMENT_METHODS = ["CASH", "BANK_TRANSFER", "CHECK", "MOBILE_MONEY", "OTHER"] as const;
+export type PaymentMethodValue = (typeof PAYMENT_METHODS)[number];
+
+export function isPaymentMethod(value: string): value is PaymentMethodValue {
+  return (PAYMENT_METHODS as readonly string[]).includes(value);
+}
+
+// "12500.50" -> 1250050 ; null si le texte n'est pas un montant valide (2 décimales max).
+export function parseCents(value: string): number | null {
+  if (!/^\d{1,12}(?:\.\d{1,2})?$/.test(value)) return null;
+  const [whole, fraction = ""] = value.split(".");
+  return Number(whole) * 100 + Number((fraction + "00").slice(0, 2));
+}
+
+export function toDecimal(cents: number): string {
+  return `${Math.floor(cents / 100)}.${String(cents % 100).padStart(2, "0")}`;
+}
+
+export type PaymentCheck =
+  | { ok: true; changeCents: number }
+  | { ok: false; error: "INSUFFICIENT" | "EXACT_REQUIRED" };
+
+// Espèces : le montant reçu couvre au moins le montant dû, la monnaie est rendue.
+// Autres modes : montant exact et référence obligatoire. Jamais de paiement partiel.
+export function checkPayment(input: {
+  method: PaymentMethodValue;
+  reference: string;
+  dueCents: number;
+  receivedCents: number;
+}): PaymentCheck {
+  if (input.method === "CASH") {
+    if (input.receivedCents < input.dueCents) return { ok: false, error: "INSUFFICIENT" };
+    return { ok: true, changeCents: input.receivedCents - input.dueCents };
+  }
+
+  if (!input.reference || input.receivedCents !== input.dueCents) {
+    return { ok: false, error: "EXACT_REQUIRED" };
+  }
+  return { ok: true, changeCents: 0 };
+}
diff --git a/prisma/migrations/20261029090000_passages_simplification/migration.sql b/prisma/migrations/20261029090000_passages_simplification/migration.sql
new file mode 100644
index 0000000..90706c7
--- /dev/null
+++ b/prisma/migrations/20261029090000_passages_simplification/migration.sql
@@ -0,0 +1,44 @@
+-- Simplification : un « passage » de produit n'existe que s'il est payé.
+-- Plus de statuts, plus de véhicules ni de chauffeurs gérés (simple description sur le passage).
+-- ATTENTION : cette migration supprime définitivement les transports non payés,
+-- les chauffeurs et les véhicules (leurs informations sont recopiées en texte sur chaque passage).
+
+-- 1. Un transport sans paiement n'a jamais eu lieu : on l'écarte, avec son produit.
+DELETE FROM "TransportAssignment" AS ta
+WHERE NOT EXISTS (SELECT 1 FROM "Payment" AS p WHERE p."assignmentId" = ta."id");
+
+DELETE FROM "Product" AS pr
+WHERE NOT EXISTS (SELECT 1 FROM "TransportAssignment" AS ta WHERE ta."productId" = pr."id");
+
+-- 2. Nouvelles colonnes : trajet et informations libres.
+ALTER TABLE "TransportAssignment"
+  ADD COLUMN "origin" TEXT NOT NULL DEFAULT 'Non renseignée',
+  ADD COLUMN "destination" TEXT NOT NULL DEFAULT 'Non renseignée',
+  ADD COLUMN "vehicleInfo" TEXT,
+  ADD COLUMN "driverName" TEXT;
+
+ALTER TABLE "TransportAssignment"
+  ALTER COLUMN "origin" DROP DEFAULT,
+  ALTER COLUMN "destination" DROP DEFAULT;
+
+-- 3. Reprise de l'existant : véhicule et chauffeur recopiés en texte sur chaque passage.
+UPDATE "TransportAssignment" AS ta
+SET "vehicleInfo" = v."vehicleType" || ' — ' || v."licensePlate",
+    "driverName" = (
+      SELECT d."firstName" || ' ' || d."lastName"
+      FROM "Driver" AS d
+      WHERE d."id" = COALESCE(ta."driverId", v."driverId")
+    )
+FROM "Vehicle" AS v
+WHERE v."id" = ta."vehicleId";
+
+-- 4. Suppression de ce qui n'existe plus (les clés étrangères et index partent avec les colonnes).
+ALTER TABLE "TransportAssignment"
+  DROP COLUMN "vehicleId",
+  DROP COLUMN "driverId",
+  DROP COLUMN "status",
+  DROP COLUMN "amountDue";
+
+DROP TABLE "Vehicle";
+DROP TABLE "Driver";
+DROP TYPE "TransportStatus";
