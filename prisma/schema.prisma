generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERVISOR
  USER_MAR
  CASHIER
  MANAGER
  ANALYST
  ADMIN
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  MOBILE_MONEY
  OTHER
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String?  @unique
  phoneNumber  String?
  passwordHash String
  role         UserRole @default(CASHIER)
  designation  String?
  isActive     Boolean  @default(true)
  sessionVersion Int    @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supervisorProfile Supervisor?
  recordedPayments  Payment[]   @relation("PaymentRecordedBy")
  auditLogs         AuditLog[]
  recordRevisions   RecordRevision[]
  maritimeProfile   MaritimeUser?

  @@index([lastName, firstName])
}

model Supervisor {
  id         String   @id @default(cuid())
  userId     String   @unique
  nationalId String   @unique
  location   String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  passages Passage[]

  locationId       String?
  assignedLocation Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([locationId])
  @@index([location])
}

model MaritimeUser {
  id                 String   @id @default(cuid())
  userId             String   @unique
  loginId            String   @unique
  contactPhone       String?  @unique
  companyName        String
  onboardingComplete Boolean  @default(true)
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  declarations MaritimeDeclaration[]
}

model MaritimeProductType {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  unitPrice      Decimal  @db.Decimal(14, 2)
  currency       String   @default("MGA")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  declarationProducts MaritimeDeclarationProduct[]

  @@index([isActive])
  @@index([name])
}

model MaritimeDeclaration {
  id                  String   @id @default(cuid())
  maritimeUserId      String
  companyName         String
  boatName            String
  boatRegistration    String
  boatCapacity        Decimal  @db.Decimal(12, 3)
  captainName         String
  captainPhone        String?
  captainEmail        String?
  originDepartureDate DateTime @db.Date
  arrivalDate         DateTime @db.Date
  departureDate       DateTime? @db.Date
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  maritimeUser MaritimeUser                 @relation(fields: [maritimeUserId], references: [id], onDelete: Restrict)
  products     MaritimeDeclarationProduct[]

  @@index([maritimeUserId, createdAt])
  @@index([companyName])
  @@index([boatName])
}

model MaritimeDeclarationProduct {
  id             String   @id @default(cuid())
  declarationId  String
  productTypeId  String?
  productType    String
  quantity       Decimal  @db.Decimal(14, 3)
  unitPrice      Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  declaration        MaritimeDeclaration       @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  maritimeProductType MaritimeProductType? @relation(fields: [productTypeId], references: [id], onDelete: SetNull)

  @@index([declarationId])
  @@index([productTypeId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  type        String
  tonnage     Decimal  @db.Decimal(10, 2)
  description String?
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime @default(now())

  passage Passage?
  @@index([deletedAt])
}

// Un passage : un produit qui passe par le lieu d'un régisseur, du lieu d'origine
// vers la destination. Il n'existe que s'il est payé : le paiement est enregistré
// en même temps (pas de statut, pas de « reste à payer »).
model Passage {
  id           String   @id @default(cuid())
  supervisorId String
  productId    String   @unique
  assignedAt   DateTime @default(now())
  origin       String
  destination  String
  vehicleInfo  String? @ignore
  driverName   String
  vehicleRegistration String
  vehicleCharacteristics String
  driverLicenseNumber String
  notes        String? @ignore
  nomOp        String?   @map("nom_op")
  nomSoc       String?   @map("nom_soc")
  coli         String?   @map("coli")
  nbColi       Int?      @map("nbcoli")
  nQuittance   String?   @map("n_quittance")
  dateQuittance DateTime? @map("date_quittance") @db.Date
  pjt          Bytes?    @map("pjt") @db.ByteA
  quittance    Bytes?    @map("quittance") @db.ByteA
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supervisor Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  payment    Payment?

  locationId       String?
  assignedLocation Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([locationId])
  @@index([supervisorId])
  @@index([assignedAt])
  @@index([deletedAt])
  @@map("TransportAssignment")
}

model Payment {
  id             String        @id @default(cuid())
  assignmentId   String        @unique
  recordedById   String
  paymentMethod  PaymentMethod
  reference      String?
  amountDue      Decimal       @db.Decimal(14, 2)
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  deletedById    String?

  passage    Passage             @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  recordedBy User                @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([assignmentId])
  @@index([recordedById])
  @@index([createdAt])
  @@index([reference])
  @@index([deletedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model RecordRevision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  version    Int
  action     String
  actorId    String
  snapshot   Json
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Location {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supervisors Supervisor[]
  passages    Passage[]

  @@index([deletedAt])
}

model LoginFailure {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}
