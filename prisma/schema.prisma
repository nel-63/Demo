generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERVISOR
  CASHIER
  MANAGER
  ANALYST
  ADMIN
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  MOBILE_MONEY
  OTHER
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  phoneNumber  String?
  passwordHash String
  role         UserRole @default(CASHIER)
  designation  String?
  isActive     Boolean  @default(true)
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supervisorProfile Supervisor?
  recordedPayments  Payment[]   @relation("PaymentRecordedBy")
  auditLogs         AuditLog[]

  @@index([lastName, firstName])
}

model Supervisor {
  id         String   @id @default(cuid())
  userId     String   @unique
  nationalId String   @unique
  location   String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  passages Passage[]

  locationId       String?
  assignedLocation Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([locationId])
  @@index([location])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  type        String
  tonnage     Decimal  @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now())

  passage Passage?
}

// Un passage : un produit qui passe par le lieu d'un régisseur, du lieu d'origine
// vers la destination. Il n'existe que s'il est payé : le paiement est enregistré
// en même temps (pas de statut, pas de « reste à payer »).
model Passage {
  id           String   @id @default(cuid())
  supervisorId String
  productId    String   @unique
  assignedAt   DateTime @default(now())
  origin       String
  destination  String
  vehicleInfo  String? // description libre du véhicule (facultatif)
  driverName   String? // nom libre du chauffeur (facultatif)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supervisor Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  payment    Payment?

  locationId       String?
  assignedLocation Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([locationId])
  @@index([supervisorId])
  @@index([assignedAt])
  @@map("TransportAssignment")
}

model Payment {
  id             String        @id @default(cuid())
  assignmentId   String        @unique
  recordedById   String
  paymentMethod  PaymentMethod
  reference      String?
  amountDue      Decimal       @db.Decimal(14, 2)
  amountReceived Decimal       @db.Decimal(14, 2)
  changeReturned Decimal       @default(0) @db.Decimal(14, 2)
  createdAt      DateTime      @default(now())

  passage    Passage             @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  recordedBy User                @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([assignmentId])
  @@index([recordedById])
  @@index([createdAt])
  @@index([reference])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Location {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supervisors Supervisor[]
  passages    Passage[]
}

model LoginFailure {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}
